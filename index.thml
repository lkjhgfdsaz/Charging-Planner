<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TVS iQube 3.5 kWh Smart Charging Planner</title>

<style>
:root {
    --primary: #0a84ff;
    --bg: #1c1c1e;
    --card-bg: #2c2c2e;
    --text: #ffffff;
    --text-secondary: #aeaeb2;
    --border: #3a3a3c;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
        Helvetica, Arial, sans-serif;
    background-color: var(--bg);
    color: var(--text);
    margin: 0;
    padding: 20px;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.calculator-card {
    background-color: var(--card-bg);
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.4);
    width: 100%;
    max-width: 460px;
    padding: 24px;
    box-sizing: border-box;
}

h2 {
    margin-top: 0;
    font-size: 20px;
    font-weight: 600;
    text-align: center;
    color: var(--primary);
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
}

.input-group {
    margin-bottom: 18px;
}

label {
    display: block;
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 6px;
}

input,
select {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background-color: var(--bg);
    color: var(--text);
    font-size: 16px;
    box-sizing: border-box;
}

input:focus,
select:focus {
    outline: none;
    border-color: var(--primary);
}

.results-box {
    background-color: var(--bg);
    border-radius: 12px;
    padding: 16px;
    margin-top: 20px;
    border: 1px solid var(--border);
}

.result-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 15px;
}

.result-row:last-child {
    margin-bottom: 0;
}

.result-value {
    font-weight: 600;
    color: var(--primary);
}

.tip-box {
    font-size: 12px;
    color: var(--text-secondary);
    margin-top: 16px;
    text-align: center;
    line-height: 1.5;
}
</style>
</head>

<body>

<div class="calculator-card">

    <h2>iQube 3.5 kWh Charging Planner</h2>

    <div class="input-group">
        <label for="currentSoc">Current Battery Percentage (%)</label>
        <input type="number"
               id="currentSoc"
               min="0"
               max="99"
               value="30"
               oninput="calculateCharging()">
    </div>

    <div class="input-group">
        <label for="targetSoc">Target Battery Percentage (%)</label>
        <select id="targetSoc" onchange="calculateCharging()">
            <option value="80" selected>80% (Recommended)</option>
            <option value="85">85% (Extended)</option>
            <option value="100">100% (Full Charge)</option>
        </select>
    </div>

    <div class="input-group">
        <label for="chargerType">Charger Power</label>
        <select id="chargerType" onchange="toggleCustomPower(); calculateCharging();">
            <option value="650" selected>Portable Charger (650W)</option>
            <option value="950">Home Fast Charger (950W)</option>
            <option value="custom">Custom Power</option>
        </select>
    </div>

    <div class="input-group" id="customPowerGroup" style="display:none;">
        <label for="customPower">Custom Charger Power (Watts)</label>
        <input type="number"
               id="customPower"
               value="650"
               min="100"
               oninput="calculateCharging()">
    </div>

    <div class="input-group">
        <label for="tariff">Electricity Cost per Unit (₹)</label>
        <input type="number"
               id="tariff"
               min="0"
               step="0.1"
               value="7.5"
               oninput="calculateCharging()">
    </div>

    <div class="results-box">

        <div class="result-row">
            <span>Required Smart Plug Timer:</span>
            <span class="result-value" id="timeResult">0h 0m</span>
        </div>

        <div class="result-row">
            <span>Charging Complete At:</span>
            <span class="result-value" id="finishResult">--:--</span>
        </div>

        <div class="result-row">
            <span>Power Consumed:</span>
            <span class="result-value" id="unitsResult">0.00 units</span>
        </div>

        <div class="result-row">
            <span>Estimated Session Cost:</span>
            <span class="result-value" id="costResult">₹0.00</span>
        </div>

    </div>

    <div class="tip-box">
        ⚡ Uses battery energy requirement and charger power to estimate timing.<br>
        Charge to 100% once every 2-3 weeks for BMS cell balancing.
    </div>

</div>

<script>

function toggleCustomPower() {
    const isCustom =
        document.getElementById("chargerType").value === "custom";

    document.getElementById("customPowerGroup").style.display =
        isCustom ? "block" : "none";
}

function calculateCharging() {

    let current =
        parseInt(document.getElementById("currentSoc").value) || 0;

    let target =
        parseInt(document.getElementById("targetSoc").value);

    let tariff =
        parseFloat(document.getElementById("tariff").value) || 0;

    current = Math.max(0, Math.min(current, 99));

    let chargerSelection =
        document.getElementById("chargerType").value;

    let chargerPower;

    if (chargerSelection === "custom") {
        chargerPower =
            parseFloat(document.getElementById("customPower").value) || 650;
    } else {
        chargerPower = parseFloat(chargerSelection);
    }

    if (current >= target) {
        document.getElementById("timeResult").innerText =
            "Already Charged";

        document.getElementById("finishResult").innerText =
            "--:--";

        document.getElementById("unitsResult").innerText =
            "0.00 units";

        document.getElementById("costResult").innerText =
            "₹0.00";

        return;
    }

    const batteryCapacity = 3.5; // kWh
    const chargerEfficiencyFactor = 1.12;

    const batteryEnergyNeeded =
        ((target - current) / 100) * batteryCapacity;

    const gridEnergyNeeded =
        batteryEnergyNeeded * chargerEfficiencyFactor;

    const chargingHours =
        gridEnergyNeeded / (chargerPower / 1000);

    const totalMinutes =
        Math.round(chargingHours * 60);

    const hours =
        Math.floor(totalMinutes / 60);

    const minutes =
        totalMinutes % 60;

    const totalCost =
        gridEnergyNeeded * tariff;

    let finishTime = new Date();

    finishTime.setMinutes(
        finishTime.getMinutes() + totalMinutes
    );

    const finishText =
        finishTime.toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit"
        });

    document.getElementById("timeResult").innerText =
        `${hours}h ${minutes}m`;

    document.getElementById("finishResult").innerText =
        finishText;

    document.getElementById("unitsResult").innerText =
        `${gridEnergyNeeded.toFixed(2)} units`;

    document.getElementById("costResult").innerText =
        `₹${totalCost.toFixed(2)}`;
}

window.onload = calculateCharging;

</script>

</body>
</html>
